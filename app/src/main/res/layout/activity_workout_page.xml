<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#EBEFF3">

    <!-- Title -->
    <TextView
        android:id="@+id/tvWorkoutTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/workout_planner"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"/>

    <!-- Workout Day Spinner -->
    <Spinner
        android:id="@+id/spinnerDay"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:spinnerMode="dropdown"/>

    <!-- Workout List -->
    <ListView
        android:id="@+id/listWorkout"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="20dp"
        android:background="@android:color/white"
        android:divider="#BDBDBD"
        android:dividerHeight="1dp"/>

    <!-- Save Button with rounded corners directly -->
    <Button
        android:id="@+id/btnSaveWorkout"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:backgroundTint="#1A237E"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:radius="20dp"
        android:shape="rectangle"
        android:stateListAnimator="@null"
        android:text="@string/save_workout"
        android:textColor="@android:color/white" />
</LinearLayout>
