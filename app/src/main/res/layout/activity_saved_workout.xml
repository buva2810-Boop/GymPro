<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EBEFF3">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/saved_workout"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Card Container -->
    <LinearLayout
        android:id="@+id/cardWorkout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Day Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/workout_day"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#1A237E"/>

        <!-- Day Value -->
        <TextView
            android:id="@+id/tvDay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chest Day"
            android:textSize="18sp"
            android:textColor="#000000"
            android:layout_marginBottom="16dp"/>

        <!-- Workouts Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/workouts"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#1A237E"/>

        <!-- Workouts Value -->
        <TextView
            android:id="@+id/tvWorkouts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bench Press, Push Ups"
            android:textSize="16sp"
            android:textColor="#000000"/>

        <Button
            android:id="@+id/btnGoBMI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Go to BMI" />

        <Button
            android:id="@+id/btnHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Back to Home" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>